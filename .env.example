# Copy this file to .env and fill in your Spotify app credentials.
# Create an app at https://developer.spotify.com/dashboard
# Add http://localhost:3000/callback as a Redirect URI in your app settings.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost:3000/callback
PORT=3000

# Plaid (for Subs auto-sync). Get these at https://dashboard.plaid.com.
# PLAID_ENV: sandbox (free, fake banks) | development | production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Origin allowed to call /plaid/* and /ai/* endpoints. Set to your Pages URL in production.
# Leave blank to allow any origin (fine for local dev).
ALLOWED_ORIGIN=

# Anthropic (for AI-assisted subscription detection from CSV/text/images).
# Get a key at https://console.anthropic.com/. Uses Claude Haiku 4.5 (~$0.01/import).
ANTHROPIC_API_KEY=

# AI backend mode. "sdk" (default) uses ANTHROPIC_API_KEY above.
# "claude-code" shells out to the Claude Code CLI on this machine, so AI
# work bills against your Claude Max plan instead of API credits.
# When AI_BACKEND=claude-code, run `claude login` once on this machine.
AI_BACKEND=sdk
# Path to the Claude Code binary, if not on PATH:
# CLAUDE_CODE_BIN=/usr/local/bin/claude
