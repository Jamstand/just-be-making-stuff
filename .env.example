# Copy this file to .env and fill in your Spotify app credentials.
# Create an app at https://developer.spotify.com/dashboard
# Add http://localhost:3000/callback as a Redirect URI in your app settings.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost:3000/callback
PORT=3000

# Plaid (for Subs auto-sync). Get these at https://dashboard.plaid.com.
# PLAID_ENV: sandbox (free, fake banks) | development | production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Origin allowed to call /plaid/* endpoints. Set to your Pages URL in production.
# Leave blank to allow any origin (fine for local dev).
ALLOWED_ORIGIN=
