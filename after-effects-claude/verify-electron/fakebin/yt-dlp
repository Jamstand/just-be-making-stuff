#!/usr/bin/env node
// Fake yt-dlp for the harness: honours -o <template> and the URL, writes a
// tiny "video" the fake ffmpeg understands (JSON: duration + a shot plan).
const fs = require("fs");
const args = process.argv.slice(2);
const template = args[args.indexOf("-o") + 1];
const url = args[args.length - 1];
if (!template || !url) { process.stderr.write("usage\n"); process.exit(2); }
if (/fail/.test(url)) { process.stderr.write("ERROR: Unsupported URL: " + url + "\n"); process.exit(1); }
const out = template.replace("%(ext)s", "mp4");
fs.writeFileSync(out, JSON.stringify({ fake: "video", url, duration: 12, fps: 30, width: 1080, height: 1920,
  // three shots: dark neutral 0-4 s, bright warm 4-8 s, mid cool 8-12 s
  shots: [{ until: 4, level: 40, rg: 0, bg: 0 }, { until: 8, level: 200, rg: 30, bg: 0 }, { until: 99, level: 90, rg: 0, bg: 25 }] }));
process.stdout.write("[download] 100% of 1.00MiB\n");
