#!/usr/bin/env node
// Fake claude CLI: honours -p/--mcp-config/stdin, speaks stream-json on
// stdout, and drives the panel's MCP server over REAL HTTP like the real
// CLI does for a {type:"http"} server.
const fs = require("fs"), http = require("http");
const args = process.argv.slice(2);
const mcpPath = args[args.indexOf("--mcp-config") + 1];
try {
  const p = require("path"), sys = args[args.indexOf("--append-system-prompt-file") + 1];
  fs.writeFileSync(p.join(require("os").homedir(), "last-turn.json"), JSON.stringify({ argv: args,
    mcp: JSON.parse(fs.readFileSync(mcpPath, "utf8")), system: sys ? fs.readFileSync(sys, "utf8") : "" }));
} catch (e) {}
const cfg = JSON.parse(fs.readFileSync(mcpPath, "utf8")).mcpServers.ae;
const out = (o) => process.stdout.write(JSON.stringify(o) + "\n");
const rpc = require(require("path").join(__dirname, "..", "mcp-rpc.js"))(cfg);
let prompt = ""; process.stdin.on("data", (d) => { prompt += d; });
process.stdin.on("end", async () => {
  prompt = prompt.trim();
  let id = 0;
  const init = await rpc({ jsonrpc: "2.0", id: ++id, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "fake-claude", version: "0" } } });
  await rpc({ jsonrpc: "2.0", method: "notifications/initialized" });
  const allServers = JSON.parse(fs.readFileSync(mcpPath, "utf8")).mcpServers;
  const authed = fs.existsSync(require("path").join(require("os").homedir(), ".fake-mcp-authed"));
  const servers = [{ name: "ae", status: init ? "connected" : "failed" }];
  let tools = ["mcp__ae__get_project_overview", "mcp__ae__create_comp", "mcp__ae__mcp_status"];
  for (const n of Object.keys(allServers)) {
    if (n === "ae") continue;
    servers.push({ name: n, status: authed ? "connected" : "needs-auth" });
    if (authed) tools = tools.concat(["mcp__" + n + "__generate_video", "mcp__" + n + "__jobs_wait"]);
  }
  out({ type: "system", subtype: "init", session_id: "sess-fake-1", mcp_servers: servers, tools });
  const call = async (name, input) => {
    out({ type: "assistant", message: { content: [{ type: "tool_use", name: "mcp__ae__" + name, input }] } });
    const r = await rpc({ jsonrpc: "2.0", id: ++id, method: "tools/call", params: { name, arguments: input } });
    return r.result; };
  if (/hello/i.test(prompt)) {
    const ov = await call("get_project_overview", {});
    out({ type: "assistant", message: { content: [{ type: "text", text: "Connected. Overview: " + ov.content[0].text }] } });
    const cc = await call("create_comp", { name: "Hello Comp", width: 1080, height: 1920, fps: 59.94, duration_s: 10 });
    out({ type: "assistant", message: { content: [{ type: "text", text: cc.isError ? "create_comp was declined: " + cc.content[0].text : "Made **Hello Comp** — `" + cc.content[0].text + "`" }] } });
  } else if (/higgsfield/i.test(prompt)) {
    const st = await call("mcp_status", {});
    out({ type: "assistant", message: { content: [{ type: "text", text: "MCP — " + st.content[0].text }] } });
  } else if (/beat|music/i.test(prompt)) {
    const os = require("os"), path = require("path");
    const audio = require(path.join(process.env.AE_EXT, "audiolib.js"));
    const j = (r) => { try { return JSON.parse(r.content[0].text); } catch (e) { return { error: r.content[0].text }; } };
    const dir = path.join(os.homedir(), "Music", "Claude Assistant"); fs.mkdirSync(dir, { recursive: true });
    const sr = 22050, secs = 12, beat = 0.5, x = new Float32Array(sr * secs);
    for (let i = 0; i < x.length; i++) x[i] = 0.01 * Math.sin(2 * Math.PI * 220 * i / sr);
    for (let k = 0; 0.2 + k * beat + 0.1 < secs; k++) {
      const s0 = Math.round((0.2 + k * beat) * sr), amp = k % 4 === 0 ? 0.9 : 0.6;
      for (let q = 0; q < 0.09 * sr; q++) x[s0 + q] += amp * Math.exp(-q / (0.03 * sr)) * Math.sin(2 * Math.PI * 60 * q / sr);
    }
    fs.writeFileSync(path.join(dir, "beat-test.wav"), audio.writeWav(x, sr));
    const list = j(await call("music_list", {}));
    const an = j(await call("analyze_music", { song: "beat-test" }));
    await call("create_comp", { name: "Beat Comp", width: 1920, height: 1080, fps: 24, duration_s: 12 });
    const f1 = path.join(os.tmpdir(), "fake-car.mp4"), f2 = path.join(os.tmpdir(), "fake-city.mp4");
    fs.writeFileSync(f1, "x"); fs.writeFileSync(f2, "y");
    await call("import_media", { paths: [f1, f2] });
    const am = j(await call("add_music", { song: "beat-test", comp: "Beat Comp", start_s: 0 }));
    const bc = j(await call("beat_control", { song: "beat-test", comp: "Beat Comp", offset_s: 0 }));
    const cuts = j(await call("cut_to_beats", { song: "beat-test", comp: "Beat Comp", items: ["fake-car.mp4", "fake-city.mp4"], pattern: [2, 2, 1, 1], count: 6, start_s: 0 }));
    const first = cuts.placed ? cuts.placed[0].layer : 1;
    const punch = j(await call("beat_effects", { comp: "Beat Comp", layer: first, style: "punch" }));
    const flash = j(await call("beat_effects", { comp: "Beat Comp", layer: first, style: "flash" }));
    out({ type: "assistant", message: { content: [{ type: "text", text: "Beat — " + JSON.stringify({ songs: list.count, analysis: an, music: am, control: bc, cuts, punch, flash }) }] } });
  } else if (/track/i.test(prompt)) {
    const os = require("os"), path = require("path");
    await call("mocha_status", {});
    const footage = path.join(os.tmpdir(), "fake-car.mp4"); fs.writeFileSync(footage, "fake footage");
    await call("import_media", { paths: [footage] });
    await call("create_comp", { name: "Track Comp", width: 1920, height: 1080, fps: 24, duration_s: 10 });
    await call("add_clip", { item_name: "fake-car.mp4", comp: "Track Comp", start_s: 1, in_s: 0, out_s: 4 });
    const tr = await call("mocha_track", { layer: 1, comp: "Track Comp", rect: [100, 100, 300, 200], exports: ["corner_pin", "mask"] });
    out({ type: "assistant", message: { content: [{ type: "text", text: (tr.isError ? "mocha_track failed: " : "Tracked — ") + tr.content[0].text }] } });
  } else {
    const cc = await call("create_comp", { name: "Second", width: 1080, height: 1080, fps: 30, duration_s: 5 });
    out({ type: "assistant", message: { content: [{ type: "text", text: cc.isError ? "Declined: " + cc.content[0].text : "Second comp made." }] } });
  }
  out({ type: "result", subtype: "success", is_error: false, session_id: "sess-fake-1", result: "done" });
  process.exit(0);
});
