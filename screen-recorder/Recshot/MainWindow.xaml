<Window x:Class="Recshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recshot"
        Icon="pack://application:,,,/Assets/recshot.ico"
        Width="1000" Height="740" MinWidth="820" MinHeight="560"
        Background="{StaticResource WindowGradient}" Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="#08FFFFFF" BorderBrush="{StaticResource GlassStroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="pack://application:,,,/Assets/recshot.ico" Width="30" Height="30" />
                    <TextBlock Text="Recshot" FontSize="21" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="OpenOverlayButton" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Open overlay" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="OverlayHint" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextTertiary}" Text="Alt+R from anywhere" />
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7F4;" Content="Capture" />
                    <RadioButton x:Name="NavVideo" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE714;" Content="Video" />
                    <RadioButton x:Name="NavAudio" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE767;" Content="Audio" />
                    <RadioButton x:Name="NavWebcam" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8B8;" Content="Webcam" />
                    <RadioButton x:Name="NavReplay" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8EE;" Content="Instant replay" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;" Content="General" />
                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE765;" Content="Hotkeys" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PageHost" Margin="36,30,36,16" MaxWidth="760" HorizontalAlignment="Left">
                <StackPanel x:Name="PageCapture" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Capture" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="What to record: a whole screen, one window, or an area." />
                <!-- What to capture -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="SourceDisplay" Content="Whole screen" GroupName="Source" Margin="0,0,18,0" />
                            <RadioButton x:Name="SourceWindow" Content="One window" GroupName="Source" Margin="0,0,18,0" />
                            <RadioButton x:Name="SourceRegion" Content="Area" GroupName="Source" />
                        </StackPanel>

                        <ComboBox x:Name="DisplayCombo" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />

                        <Grid x:Name="WindowPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCombo" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
                            <Button x:Name="RefreshWindowsButton" Grid.Column="1" Content="Refresh" Margin="8,0,0,0" ToolTip="Reload the list of open windows" />
                        </Grid>

                        <Grid x:Name="RegionPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickRegionButton" Content="Select area…" />
                            <TextBlock x:Name="RegionText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" Text="No area selected yet" />
                        </Grid>

                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="ShowCursorCheck" Content="Show mouse pointer" Margin="0,0,20,0" />
                            <CheckBox x:Name="ClicksCheck" Content="Highlight clicks" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageVideo" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Video" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Resolution, frame rate and the encoder on your graphics card." />
                <!-- Video -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Resolution" />
                                <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Frame rate" />
                                <ComboBox x:Name="FpsCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Quality" />
                                <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Encoder" />
                                <ComboBox x:Name="EncoderCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="File type" />
                                <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="EncoderHint" Style="{StaticResource Hint}" Text="Checking which encoders your PC supports…" />
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Audio" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Your microphone and everything your PC plays, each on its own track." />
                <!-- Audio -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SystemAudioCheck" Content="Computer sound" VerticalAlignment="Center" />
                            <ComboBox x:Name="SystemDeviceCombo" Grid.Column="1" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="28,0,0,0" />
                            <Slider x:Name="SystemVolumeSlider" Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="SystemVolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="100%" />
                        </Grid>
                        <ProgressBar x:Name="SystemMeter" Style="{StaticResource Meter}" Margin="150,4,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MicCheck" Content="Microphone" VerticalAlignment="Center" />
                            <ComboBox x:Name="MicDeviceCombo" Grid.Column="1" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="28,0,0,0" />
                            <Slider x:Name="MicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="MicVolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="100%" />
                        </Grid>
                        <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Margin="150,4,0,0" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="With both on, videos get 3 audio tracks: 1 = both mixed (what players play), 2 = computer sound only, 3 = mic only. Editors like Premiere, Resolve and Shotcut let you adjust each one." />
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageWebcam" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Webcam" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="A camera bubble composited into the corner of your recordings." />
                <!-- Webcam -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="WebcamCheck" Content="Show webcam" VerticalAlignment="Center" />
                            <ComboBox x:Name="WebcamCombo" Grid.Column="1" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Corner" />
                                <ComboBox x:Name="WebcamCornerCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Size" />
                                <ComboBox x:Name="WebcamSizeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Shape" />
                                <ComboBox x:Name="WebcamShapeCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="WebcamMirrorCheck" Content="Mirror (like a selfie camera)" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageReplay" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Instant replay" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Always recording in the background. Save the last moments with one key." />
                <!-- Replay buffer -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ReplayCheck" Content="Always keep the last" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox x:Name="ReplayLengthCombo" Grid.Column="1" />
                            <Button x:Name="SaveReplayButton" Grid.Column="3" Content="Save replay" />
                        </Grid>
                        <TextBlock x:Name="ReplayHint" Style="{StaticResource Hint}"
                                   Text="Records continuously in the background without keeping files. Press the Save replay hotkey to keep what just happened." />
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Where files go and how Recshot runs in the background." />
                <!-- Saving -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Videos folder" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VideoFolderBox" IsReadOnly="True" />
                            <Button x:Name="BrowseVideoButton" Grid.Column="1" Content="Change…" Margin="8,0,0,0" />
                            <Button x:Name="OpenVideoButton" Grid.Column="2" Content="Open" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Screenshots folder" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ShotFolderBox" IsReadOnly="True" />
                            <Button x:Name="BrowseShotButton" Grid.Column="1" Content="Change…" Margin="8,0,0,0" />
                            <Button x:Name="OpenShotButton" Grid.Column="2" Content="Open" Margin="8,0,0,0" />
                        </Grid>
                        <CheckBox x:Name="ClipboardCheck" Content="Also copy screenshots to the clipboard" Margin="0,12,0,0" />
                        <CheckBox x:Name="HideSelfCheck" Content="Keep Recshot's own window out of recordings and screenshots" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Background -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="CloseToTrayCheck" Content="Closing or minimising hides Recshot to the tray (it keeps running)" />
                        <CheckBox x:Name="StartupCheck" Content="Start with Windows, hidden in the tray" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Turn on the replay buffer too and Recshot works like a background instant-replay: always ready, saved with one hotkey. Right-click the tray icon for quick actions; Quit from there to fully exit." />
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Hotkeys" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Shortcuts that work from anywhere, even in full-screen games." />
                <!-- Hotkeys -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Start / stop recording" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyRecordBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            <TextBlock Grid.Row="1" Text="Pause / resume" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyPauseBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            <TextBlock Grid.Row="2" Text="Save replay" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyReplayBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            <TextBlock Grid.Row="3" Text="Screenshot" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyShotBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            <TextBlock Grid.Row="4" Text="Open the overlay" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyOverlayBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                            <TextBlock Grid.Row="5" Text="Mute / unmute mic" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyMicBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                                   Text="Click a box and press the new key combination. Backspace clears it." />
                    </StackPanel>
                </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Action bar -->
        <Border Grid.Row="1" Grid.Column="1" Padding="36,14,36,16" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GlassStroke}" Background="#0DFFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RecordButton" Grid.Column="0" MinWidth="160" Style="{StaticResource PrimaryPill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordDot" Width="11" Height="11" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecordLabel" Text="Start recording" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Grid.Column="1" Content="Pause" Margin="10,0,0,0" MinWidth="90" Style="{StaticResource PillButton}" />
                <TextBlock x:Name="TimerText" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="20" Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono, Consolas" Text="00:00:00" Opacity="0.55" />
                <Button x:Name="WindowShotButton" Grid.Column="3" Content="Window shot" Margin="10,0,0,0" Style="{StaticResource PillButton}"
                        ToolTip="Screenshot the window picked under 'One window' (even if it's partly covered)" />
                <Button x:Name="ScreenshotButton" Grid.Column="4" Content="Screenshot" Margin="10,0,0,0" Style="{StaticResource PillButton}"
                        ToolTip="Drag to capture an area, or click to capture a whole screen" />

                <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Text="Starting…" />
            </Grid>
        </Border>
    </Grid>
</Window>
