--[[
    GENERATED by art/blender/build.py anims from the Blender actions on the
    SkyRig armature. Do not edit by hand; edit art/blender/anims/*.py.

    Clips[name] = { Phased, Loop, Length, Keys }
      Phased  key times are move phases: 0-1 startup, 1-2 active, 2-3 recovery
              (otherwise seconds)
      Keys    { T, E = "Style.Direction" easing toward the next key,
                R = flat { x, y, z, ... } degrees per joint in Joints order
                (CFrame.Angles on the joint, rig space), O = root offset }
    Clips are authored facing right; the game mirrors them for facing left.
]]

local Data = {
	Version = 2,
	Joints = { "Root", "Waist", "Neck", "RightShoulder", "RightElbow", "RightWrist", "LeftShoulder", "LeftElbow", "LeftWrist", "RightHip", "RightKnee", "RightAnkle", "LeftHip", "LeftKnee", "LeftAnkle" },
	Clips = {},
}

for _, group in {
	require(script.Bow),
	require(script.Brann),
	require(script.Gauntlets),
	require(script.Hammer),
	require(script.Kestrel),
	require(script.Loco),
	require(script.Moss),
	require(script.Scythe),
	require(script.Sol),
	require(script.Spear),
	require(script.Sword),
	require(script.Unarmed),
	require(script.Vex),
	require(script.Yuki),
} do
	for name, clip in group do
		Data.Clips[name] = clip
	end
end

return Data
